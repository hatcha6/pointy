# Pointy Relay — local development environment.
#
# Copy this file to relay/.env and fill in your values:
#   cp .env.example .env
#
# The relay loads relay/.env automatically (see cmd/pointy-relay/dotenv.go).
# Real environment variables and `make relay-run` values take precedence, so a
# value here only applies when the variable is otherwise empty or unset.
# relay/.env is gitignored; this .env.example is the tracked template.

# ── Core server ──────────────────────────────────────────────────────────────
# Bearer token required for admin/control endpoints (provision, subscription,
# status). Any non-empty value works for local dev.
POINTY_RELAY_ADMIN_TOKEN=local-admin

# Durable installation state (token hashes, subscription + AI flags, certs).
# Run `make postgres` then `make relay-migrate` before first use.
POINTY_RELAY_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/pointy?sslmode=disable

# Hot cache, connector presence, tickets, refresh tokens, rate limits.
POINTY_RELAY_REDIS_URL=redis://127.0.0.1:6379/0

# Public phone listener and on-prem connector listener.
POINTY_RELAY_HTTP_ADDR=127.0.0.1:8091
POINTY_RELAY_CONNECTOR_ADDR=127.0.0.1:8092

# ── Local-dev security (DO NOT enable in production) ─────────────────────────
# Allow cleartext listeners + insecure control for local development. In
# production omit these (or set false) and configure TLS instead.
POINTY_RELAY_ALLOW_INSECURE_HTTP=true
POINTY_RELAY_ALLOW_INSECURE_CONNECTOR=true
POINTY_RELAY_ALLOW_INSECURE_CONTROL=true

# ── AI (OpenRouter) ──────────────────────────────────────────────────────────
# The relay hosts AI chat. AI stays disabled until a key is set.
# Get one at https://openrouter.ai/keys
POINTY_RELAY_OPENROUTER_API_KEY=
POINTY_RELAY_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Tier -> OpenRouter model id. Clients pick a tier (fast/smart/frontier); the
# relay maps it to a model. These dev defaults are FREE models (`:free`) so local
# development costs nothing — browse https://openrouter.ai/models?max_output_price=0
# for the current list. Production should override these with paid models for
# quality/stability; confirm ids against the live OpenRouter catalog.
POINTY_RELAY_AI_MODEL_FAST=openai/gpt-oss-20b:free
POINTY_RELAY_AI_MODEL_SMART=meta-llama/llama-3.3-70b-instruct:free
POINTY_RELAY_AI_MODEL_FRONTIER=openai/gpt-oss-120b:free

# The relay auto-routes by prompt difficulty (a small classifier picks the tier),
# once per task. The chosen tier rides the agentic tool-loop, so a hard flow (e.g.
# a purchase order from an invoice) escalates while a trivial one stays cheap —
# dynamically, no per-flow hard-coding. This is the fallback tier when the router
# is unavailable.
POINTY_RELAY_AI_DEFAULT_TIER=smart

# Model that classifies difficulty to pick a tier; empty uses the fast-tier model.
POINTY_RELAY_AI_ROUTER_MODEL=

# Web search: when a user's question needs current/external info (a cheap
# classifier decides per turn — never on the shop's own-data questions), the relay
# attaches OpenRouter's web-search plugin so the model answers from up-to-date
# sources and cites them. Each search costs (~$0.005 via Exa). Tune/disable here.
POINTY_RELAY_AI_WEB_SEARCH_ENABLED=true
POINTY_RELAY_AI_WEB_SEARCH_MAX_RESULTS=3

# Per-request stream timeout and per-installation AI rate limit (per window).
POINTY_RELAY_AI_REQUEST_TIMEOUT=120s
POINTY_RELAY_AI_RATE_LIMIT=120

# Model used when a prompt carries image/file attachments (free multimodal model
# for dev). PDFs/docs route through OpenRouter's file-parser plugin automatically.
POINTY_RELAY_AI_VISION_MODEL=google/gemma-4-31b-it:free

# Subscription usage limits, Claude Code / Codex style: a rolling 5-hour cap and
# a weekly cap on AI messages per installation (set a limit to 0 to disable that
# window). Surfaced to the app as a usage ring via GET /v1/ai/usage.
POINTY_RELAY_AI_LIMIT_5H=30
POINTY_RELAY_AI_LIMIT_5H_WINDOW=5h
POINTY_RELAY_AI_LIMIT_WEEKLY=200
POINTY_RELAY_AI_LIMIT_WEEKLY_WINDOW=168h

# Max images per prompt (enforced here AND on the app) and the max request body
# (prompt + base64 attachments). Raise the body cap if you raise the image cap.
POINTY_RELAY_AI_MAX_IMAGES=5
POINTY_RELAY_AI_MAX_REQUEST_BYTES=16777216

# ── Image search (Serper.dev) ────────────────────────────────────────────────
# The relay also hosts product image search, so shops never manage a search key
# or subscription — the relay holds one key for everyone and gates each request
# on the shop's relay subscription. Empty disables the /v1/image-search endpoint.
# Get a key at https://serper.dev. Optional knobs (defaults shown) tune the
# Serper endpoint and the image locale.
POINTY_RELAY_SERPER_API_KEY=
# POINTY_RELAY_SERPER_BASE_URL=https://google.serper.dev/images
# POINTY_RELAY_SERPER_IMAGE_LANGUAGE=ar
# POINTY_RELAY_SERPER_IMAGE_COUNTRY=us

# ── On-prem connector (only for `pointy-relay connector`) ────────────────────
# One-time bootstrap token consumed by the local Django backend the first time
# the connector pairs. Must match POINTY_RELAY_CONNECTOR_SETUP_TOKEN in
# backend/.env.
POINTY_RELAY_CONNECTOR_SETUP_TOKEN=local-connector-setup

# ── Optional knobs (sensible defaults already applied; uncomment to override) ─
# POINTY_RELAY_TICKET_TTL=15m
# POINTY_RELAY_TICKET_REFRESH_TTL=168h
# POINTY_RELAY_REQUEST_TIMEOUT=60s
# POINTY_RELAY_RATE_LIMIT_WINDOW=1m
# POINTY_RELAY_RATE_LIMIT_RELAY_REQUESTS=600
# POINTY_RELAY_MAX_REQUEST_BODY_BYTES=10485760
# POINTY_RELAY_MAX_RESPONSE_BODY_BYTES=52428800
# POINTY_RELAY_MAX_CONCURRENT_REQUESTS=512
#
# Separate private admin/control listener (production). Keep off the public LB.
# POINTY_RELAY_ADMIN_HTTP_ADDR=127.0.0.1:8093
#
# Enforce production security (refuses insecure startup config).
# POINTY_RELAY_PRODUCTION=true
