# Copy this file to deploy/onprem/.env and replace every secret before launch.

COMPOSE_PROJECT_NAME=pointy

# Local image names. Keep :local for single-site builds, or replace with registry tags.
POINTY_BACKEND_IMAGE=pointy-backend:local
POINTY_RELAY_IMAGE=pointy-relay:local

# Windows/LAN exposure. Set POINTY_DISCOVERY_API_BASE_URL to the server's LAN IP.
POINTY_BACKEND_BIND=0.0.0.0
POINTY_DISCOVERY_UDP_BIND=0.0.0.0
POINTY_DISCOVERY_API_BASE_URL=http://192.168.1.50:8000

# Database. Keep the Postgres password URL-safe, or URL-encode it in POINTY_DATABASE_URL.
POINTY_POSTGRES_PASSWORD=replace-with-long-url-safe-password
POINTY_DATABASE_URL=postgres://pointy:replace-with-long-url-safe-password@postgres:5432/pointy
POINTY_REDIS_URL=redis://redis:6379/0

# Django security and LAN/web origins.
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,192.168.1.50
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://192.168.1.50:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://192.168.1.50:8080
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_PROXY_SSL_HEADER=

# Container resource limits. Caps prevent any single service from exhausting
# host RAM/CPU (e.g. a runaway report or worker leak taking down the till).
# Defaults below total well under 8GB; raise them on larger hosts.
POINTY_POSTGRES_MEM_LIMIT=1g
POINTY_POSTGRES_CPUS=1.5
POINTY_REDIS_MEM_LIMIT=768m
POINTY_REDIS_CPUS=1
POINTY_BACKEND_MEM_LIMIT=2g
POINTY_BACKEND_CPUS=2
POINTY_WORKER_MEM_LIMIT=1536m
POINTY_WORKER_CPUS=2
POINTY_BEAT_MEM_LIMIT=256m
POINTY_BEAT_CPUS=0.5
POINTY_CONNECTOR_MEM_LIMIT=128m
POINTY_CONNECTOR_CPUS=0.5

# Auth brute-force throttling. DJANGO_NUM_PROXIES must match the number of
# trusted proxies in front of the backend so the real client IP is used; keep 0
# when terminals reach the backend directly on the LAN.
DJANGO_NUM_PROXIES=0
DJANGO_THROTTLE_LOGIN=30/min
DJANGO_THROTTLE_LOGIN_USERNAME=6/min
DJANGO_THROTTLE_SETUP=5/hour

# Backend ASGI process sizing. These defaults are conservative for an 8GB Windows host.
POINTY_ASGI_WORKERS=3
POINTY_ASGI_KEEP_ALIVE=5
POINTY_ASGI_GRACEFUL_TIMEOUT=30
POINTY_ASGI_MAX_REQUESTS=1000
POINTY_ASGI_MAX_REQUESTS_JITTER=100
POINTY_ASGI_LIMIT_CONCURRENCY=
POINTY_ASGI_PROXY_HEADERS=0
POINTY_ASGI_FORWARDED_ALLOW_IPS=127.0.0.1
CELERY_WORKER_CONCURRENCY=2

# External backup storage. On Windows, set these to real connected drives/folders.
# Examples: D:/, E:/PointyBackups, F:/Stores/Pointy
POINTY_BACKUP_DRIVE_1_SOURCE=./external-backups/drive-1
POINTY_BACKUP_DRIVE_2_SOURCE=./external-backups/drive-2
POINTY_BACKUP_DRIVE_3_SOURCE=./external-backups/drive-3

# Relay cloud settings used by the on-prem backend and connector.
POINTY_RELAY_CONTROL_URL=https://relay.example.com
POINTY_RELAY_PUBLIC_API_URL=https://relay.example.com
POINTY_RELAY_CONNECTOR_ADDR=relay.example.com:443
POINTY_RELAY_ADMIN_TOKEN=replace-with-relay-admin-token
POINTY_RELAY_CONNECTOR_SETUP_TOKEN=replace-with-one-time-connector-setup-token
POINTY_RELAY_CONNECTOR_TLS_SERVER_NAME=relay.example.com
POINTY_RELAY_ALLOW_INSECURE_CONTROL=false
POINTY_RELAY_ALLOW_INSECURE_CONNECTOR=false

# Optional image search providers.
POINTY_IMAGE_SEARCH_PROVIDERS=serper,serpapi
POINTY_SERPER_API_KEY=
POINTY_SERPAPI_API_KEY=
