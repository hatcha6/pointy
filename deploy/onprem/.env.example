# Copy this file to deploy/onprem/.env and replace every secret before launch.

COMPOSE_PROJECT_NAME=pointy

# Local image names. Keep :local for single-site builds, or replace with registry tags.
POINTY_BACKEND_IMAGE=pointy-backend:local
POINTY_RELAY_IMAGE=pointy-relay:local
POINTY_WEB_IMAGE=pointy-web:local

# LAN exposure. The backend binds on all interfaces and tills find it via UDP
# discovery — no IP to configure here. The server auto-detects and advertises
# its own LAN IP to each till (per-interface, works offline), so a DHCP address
# is fine. Only set POINTY_DISCOVERY_API_BASE_URL to FORCE a specific address
# (e.g. a reverse proxy or DNS name clients must use instead of the raw IP).
POINTY_BACKEND_BIND=0.0.0.0
POINTY_DISCOVERY_UDP_BIND=0.0.0.0
POINTY_DISCOVERY_API_BASE_URL=
# A static IP (DHCP reservation) is still RECOMMENDED for stability: if the
# server's IP changes, tills re-discover automatically but briefly drop.

# Browser access. The `web` service serves the Flutter web app and proxies the
# API on the same origin, so any device on the LAN can open http://<server-ip>/
# in a browser — no install. Change POINTY_WEB_PORT if port 80 is taken.
POINTY_WEB_BIND=0.0.0.0
POINTY_WEB_PORT=80

# Database. Keep the Postgres password URL-safe, or URL-encode it in POINTY_DATABASE_URL.
POINTY_POSTGRES_PASSWORD=replace-with-long-url-safe-password
POINTY_DATABASE_URL=postgres://pointy:replace-with-long-url-safe-password@postgres:5432/pointy
POINTY_REDIS_URL=redis://redis:6379/0
# Redis caches of near-static DB state (seconds; 0 disables). Invalidation is
# signal-driven, so these TTLs only bound out-of-band edits (raw SQL in psql).
# POINTY_SHOP_SETTINGS_CACHE_TTL=60
# POINTY_PERMISSION_CACHE_TTL=300
# POINTY_DISCOUNT_PREVIEW_CACHE_TTL=15
# POINTY_CATALOG_CACHE_ENABLED=true
# POINTY_PRICE_LOOKUP_CACHE_TTL=30

# Django security and LAN/web origins.
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=false
# No LAN IP needed: POINTY_ALLOW_PRIVATE_HOSTS (on by default in the compose
# file) makes the backend accept any private/LAN IP as a Host while still
# rejecting public hostnames, so tills connect to whatever IP discovery hands
# them. Add a reverse-proxy DNS name here only if clients reach the API by name.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# CORS/CSRF only matter for BROWSER clients (the Django admin or a web build) —
# the native Android/Windows tills do not need them. If you open the admin from
# a browser on the LAN, add that origin (including the server IP) here.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_PROXY_SSL_HEADER=

# Container resource limits. Caps prevent any single service from exhausting
# host RAM/CPU (e.g. a runaway report or worker leak taking down the till).
# Defaults below total well under 8GB; raise them on larger hosts.
POINTY_POSTGRES_MEM_LIMIT=1g
POINTY_POSTGRES_CPUS=1.5
POINTY_REDIS_MEM_LIMIT=768m
POINTY_REDIS_CPUS=1
POINTY_BACKEND_MEM_LIMIT=2g
POINTY_BACKEND_CPUS=2
POINTY_WORKER_MEM_LIMIT=1536m
POINTY_WORKER_CPUS=2
POINTY_BEAT_MEM_LIMIT=256m
POINTY_BEAT_CPUS=0.5
POINTY_CONNECTOR_MEM_LIMIT=128m
POINTY_CONNECTOR_CPUS=0.5
POINTY_WEB_MEM_LIMIT=128m
POINTY_WEB_CPUS=0.5

# Auth brute-force throttling. DJANGO_NUM_PROXIES must match the number of
# trusted proxies in front of the backend so the real client IP is used; keep 0
# when terminals reach the backend directly on the LAN.
DJANGO_NUM_PROXIES=0
DJANGO_THROTTLE_LOGIN=30/min
DJANGO_THROTTLE_LOGIN_USERNAME=6/min
DJANGO_THROTTLE_SETUP=5/hour

# Backend ASGI process sizing. These defaults are conservative for an 8GB Windows host.
POINTY_ASGI_WORKERS=3
POINTY_ASGI_KEEP_ALIVE=5
POINTY_ASGI_GRACEFUL_TIMEOUT=30
POINTY_ASGI_MAX_REQUESTS=1000
POINTY_ASGI_MAX_REQUESTS_JITTER=100
POINTY_ASGI_LIMIT_CONCURRENCY=
POINTY_ASGI_PROXY_HEADERS=0
POINTY_ASGI_FORWARDED_ALLOW_IPS=127.0.0.1
CELERY_WORKER_CONCURRENCY=2

# External backup storage. On Windows, set these to real connected drives/folders.
# Examples: D:/, E:/PointyBackups, F:/Stores/Pointy
POINTY_BACKUP_DRIVE_1_SOURCE=./external-backups/drive-1
POINTY_BACKUP_DRIVE_2_SOURCE=./external-backups/drive-2
POINTY_BACKUP_DRIVE_3_SOURCE=./external-backups/drive-3

# Relay cloud settings used by the on-prem backend and connector. The URLs below
# point at the production hosted relay (LibyanSpider JPaaS):
#  - CONTROL_URL / PUBLIC_API_URL ride the HTTPS edge on 443.
#  - CONNECTOR_ADDR is the raw-TCP L4 endpoint that forwards to the relay's 8092
#    connector listener (the env hostname itself only carries HTTP/443 via the SLB).
#  - TLS_SERVER_NAME stays the env hostname so the connector validates the relay
#    cert by name even though it dials the endpoint host.
# This backend self-licenses on first boot: it redeems a single-use license key
# (POINTY_RELAY_ENROLLMENT_TOKEN) with the relay, which returns the scoped
# per-installation credentials — so it never holds the company-wide admin token.
# The installer fills POINTY_RELAY_ENROLLMENT_TOKEN from your license.key file and
# generates POINTY_RELAY_CONNECTOR_SETUP_TOKEN; you normally don't edit these by
# hand. POINTY_REQUIRE_LICENSE=true locks the API until enrollment succeeds —
# but it is OFF for now so shops with no internet can run fully offline (an
# offline install can never redeem the key with the relay). Flip it back to true
# once the shop has internet and you want to enforce licensing.
# See deploy/onprem/INSTALL.md.
# NOTE: the env id (env-9493505) and node/endpoint port (node11166…:11061) are
# platform-generated and will churn if the env or endpoint is recreated; move to a
# stable custom domain before this ships widely.
POINTY_RELAY_CONTROL_URL=https://env-9493505.tip2.libyanspider.cloud
POINTY_RELAY_PUBLIC_API_URL=https://env-9493505.tip2.libyanspider.cloud
POINTY_RELAY_CONNECTOR_ADDR=node11166-env-9493505.tip2.libyanspider.cloud:11061
POINTY_RELAY_CONNECTOR_TLS_SERVER_NAME=env-9493505.tip2.libyanspider.cloud
# Auto-filled by the installer (from license.key / generated) — leave blank here.
POINTY_RELAY_ENROLLMENT_TOKEN=
POINTY_RELAY_CONNECTOR_SETUP_TOKEN=
POINTY_REQUIRE_LICENSE=false
POINTY_RELAY_ALLOW_INSECURE_CONTROL=false
POINTY_RELAY_ALLOW_INSECURE_CONNECTOR=false

# Product image search is relay-hosted: the Serper.dev key lives on the relay
# (POINTY_RELAY_SERPER_API_KEY), so on-prem shops never configure a search key.
