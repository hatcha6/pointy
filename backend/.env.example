DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Development conveniences. Both stay OFF in deployments: the admin is a
# browsable model/bulk-export surface and the schema documents the whole API.
POINTY_ENABLE_DJANGO_ADMIN=true
POINTY_ENABLE_API_DOCS=true
DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=redis://localhost:6379/0
# Seconds before a cache call gives up on an unresponsive Redis and the
# fail-open guards take over. Never leave these unset in code: redis-py's
# default is "block forever".
POINTY_REDIS_SOCKET_TIMEOUT=1.0
POINTY_REDIS_SOCKET_CONNECT_TIMEOUT=1.0
POINTY_EXPIRY_ALERT_WINDOW_DAYS=30
POINTY_NOTIFICATION_SYNC_INTERVAL_MINUTES=15
POINTY_FRAUD_DETECTION_INTERVAL_MINUTES=15
POINTY_FRAUD_DETECTION_LOOKBACK_DAYS=30
POINTY_BACKUP_ALLOWED_ROOTS=backups,/mnt,/media,/run/media,/Volumes
POINTY_BACKUP_STAGING_ROOT=/tmp/pointy-backup-staging
POINTY_BACKUP_RETENTION_COUNT=7
POINTY_BACKUP_RESTORE_MAX_BYTES=5368709120

# Auth brute-force throttling (applied only to login/setup/password-change).
# DJANGO_NUM_PROXIES: trusted reverse proxies in front of the backend, used to
# derive the client IP for throttling. 0 = use the direct peer (REMOTE_ADDR),
# which prevents X-Forwarded-For spoofing; set to the real hop count (e.g.
# relay + nginx) to throttle on the true client IP.
DJANGO_NUM_PROXIES=0
DJANGO_THROTTLE_LOGIN=30/min
DJANGO_THROTTLE_LOGIN_USERNAME=6/min
DJANGO_THROTTLE_SETUP=20/hour
DJANGO_THROTTLE_PASSWORD_CHANGE=10/min

# Celery task time limits (seconds). Backup/restore use their own higher limits.
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_TASK_TIME_LIMIT=1800
POINTY_BACKUP_TASK_SOFT_TIME_LIMIT=21600
POINTY_BACKUP_TASK_TIME_LIMIT=21900

# Extra roots (beyond the attachment storage root) where storage volumes may
# live. Leave empty unless you mount attachment volumes outside the storage
# root; the storage root is always allowed.
POINTY_ATTACHMENT_ALLOWED_VOLUME_ROOTS=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080
POINTY_ATTACHMENT_STORAGE_ROOT=media
POINTY_ATTACHMENT_MAX_UPLOAD_BYTES=104857600
POINTY_ATTACHMENT_CONTENT_TOKEN_MAX_AGE_SECONDS=21600
POINTY_PRODUCT_IMAGE_IMPORT_MAX_BYTES=10485760
# Product image search is relay-hosted: the Serper.dev key lives on the relay
# (POINTY_RELAY_SERPER_API_KEY in relay/.env), not here.
POINTY_RELAY_CONTROL_URL=
POINTY_RELAY_PUBLIC_API_URL=
POINTY_RELAY_CONNECTOR_ADDR=
POINTY_RELAY_ADMIN_TOKEN=
POINTY_RELAY_BUSINESS_ID=
POINTY_RELAY_REQUEST_TIMEOUT_SECONDS=5
POINTY_RELAY_ALLOW_INSECURE_CONTROL=false
POINTY_RELAY_CONTROL_CA_FILE=
POINTY_RELAY_CONTROL_CLIENT_CERT_FILE=
POINTY_RELAY_CONTROL_CLIENT_KEY_FILE=
POINTY_RELAY_CONNECTOR_SETUP_TOKEN=
POINTY_RELAY_CONNECTOR_TLS_SERVER_NAME=
POINTY_DISCOVERY_ENABLED=true
POINTY_DISCOVERY_PRIVATE_ONLY=true
POINTY_DISCOVERY_UDP_ENABLED=true
POINTY_DISCOVERY_UDP_PORT=47777
POINTY_DISCOVERY_API_PORT=8000
POINTY_DISCOVERY_API_BASE_URL=
POINTY_DISCOVERY_TRUST_PROXY_HEADERS=false

# --- Surveillance (DVR/NVR cameras) ---------------------------------------
# ffmpeg carries live view (RTSP -> MJPEG, which is the only path that can
# reach the 30fps a modern recorder streams), plus playback, clip export and
# stills. The shipped image installs it; set POINTY_FFMPEG_PATH only when the
# host has its own build somewhere non-standard. Without it the backend falls
# back to polling JPEG snapshots for live at up to 8fps, reports playback and
# export as unavailable, and the app hides what it cannot do.
POINTY_FFMPEG_PATH=
# Concurrent ffmpeg pipelines allowed on this worker. Sized so a full 3x3 wall
# streams live AND someone reviews a recording at the same time: a cap that
# refuses the ninth camera is indistinguishable from a broken ninth camera.
POINTY_SURVEILLANCE_MAX_FFMPEG=12
# Distinct camera streams one worker will pull at once, live included.
POINTY_SURVEILLANCE_MAX_PRODUCERS=32
# How long a stream keeps running after its last viewer leaves, so switching
# screens reuses the pipeline instead of restarting it.
POINTY_SURVEILLANCE_LINGER_SECONDS=6
# Silence from the recorder that ends a stream and asks the client to retry.
POINTY_SURVEILLANCE_STALL_SECONDS=20
# The live view a dashboard tile gets on a recorder with no still-image endpoint
# (Xiongmai has none): keyframes sampled out of its video stream. Both numbers
# are the server's rather than the tile's, which is what lets every viewer of a
# camera share one pipeline instead of starting an ffmpeg per distinct request.
# Set to 0 to switch the sampled path off and go back to full decodes.
POINTY_SURVEILLANCE_STILL_FPS=2
# Rendered width for those stills. Only ever shrinks — a narrower sub-stream is
# passed through untouched. 0 means "whatever the stream is".
POINTY_SURVEILLANCE_STILL_WIDTH=640
