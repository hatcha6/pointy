[Desktop Entry]
Type=Application
Version=1.0
# The brand is دفتر in every locale — the same string Android shows
# (android:label in AndroidManifest.xml) and the Windows shortcuts carry. No
# Name[en]: an English-locale desktop would label the shortcut "Daftar".
Name=دفتر
GenericName=نقطة بيع
GenericName[en]=Point of Sale
Comment=نقطة البيع والمخزون
Comment[en]=Point of sale and inventory
Exec=/usr/bin/pointy
Icon=ly.daftr
Terminal=false
Categories=Office;Finance;
Keywords=pos;pointy;daftar;نقطة بيع;كاشير;
StartupNotify=true
# How Cinnamon/GNOME tie the running window back to this entry (icon in the
# task list, pinning to the panel). The runner calls g_set_prgname(APPLICATION_ID)
# (linux/runner/my_application.cc), so WM_CLASS is the application id and not the
# binary name — and it stays that way however the app was launched.
StartupWMClass=ly.daftr
