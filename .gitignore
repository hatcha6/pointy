.DS_Store
__pycache__/
*.py[cod]
.venv/
*.egg-info/
db.sqlite3
.env

frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/build/
frontend/coverage/
backend/media/
relay/.gocache/
relay/.gomodcache/
relay/data/
# dev-remote: per-run connector setup token + connector state (holds the
# connector's private key + scoped token). Both are regenerated locally.
relay/.remote-setup-token
relay/.connector-state-remote.json

# Local PyArmor license material and generated diagnostics.
pyarmor-regfile-1941/
pyarmor.bug.log

# Production database dumps pulled from a client for analysis. Multi-gigabyte,
# and they carry the shop's real sales, customers and staff — never commit one.
*.sql
*.sql.gz
*.sql.tar.gz
*.dump
*.pgdump

# Analytics event exports pulled from a shop for field analysis. Same reasoning
# as the dumps above: they are large, and every event carries a real till's
# real activity. Unzipped alongside the repo root by habit, so match anywhere.
pointy-analytics-events*.zip

# Legacy client DB exports for data migration (large binaries)
*.mdb
fahd_data.sqlite
fahd_migration.sqlite

# Operator workspace: compiled admin CLI + local .env holding the production
# fleet admin token. Rebuild with `make relay-cli`.
/ops/
