# دفتر product page on the LibyanSpider plan (Apache / LiteSpeed).
# Copied to the root of the upload by deploy/build.sh.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# HTTPS only, and one host: www.dftr.ly → dftr.ly.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://dftr.ly%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://dftr.ly%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType video/mp4 .mp4
  AddCharset utf-8 .html .css .js .txt .xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/xml image/svg+xml
</IfModule>

# Assets are re-uploaded under the same names, so cache them for a week, not
# forever; the page itself is always revalidated.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|webp|png|jpg|woff2|mp4)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Nothing but the site itself is served.
<FilesMatch "^(\.|README|.*\.(md|sh|py|zip)$)">
  Require all denied
</FilesMatch>
